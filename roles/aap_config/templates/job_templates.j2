---
controller_templates:
- name: {{ item.name }}
  job_type: {{ item.job_type }}
  inventory: {{ item.summary_fields.inventory.name }}
  organization: {{ item.summary_fields.organization.name }}
  execution_environment: {{ item.execution_environment | default(omit) }}
  project: {{ item.summary_fields.project.name }}
  playbook: {{ item.playbook }}
  scm_branch: {{ item.scm_branch }}
  forks: {{ item.forks }}
  limit: {{ item.limit }}
  verbosity: {{ item.verbosity }}
  job_tags: {{ item.job_tags }}
  skip_tags: {{ item.skip_tags }}
  timeout: {{ item.timeout }}
  ask_scm_branch_on_launch: {{ item.ask_scm_branch_on_launch }}
  ask_diff_mode_on_launch: {{ item.ask_diff_mode_on_launch }}
  ask_variables_on_launch: {{ item.ask_variables_on_launch }}
  ask_limit_on_launch: {{ item.ask_limit_on_launch }}
  ask_tags_on_launch: {{ item.ask_tags_on_launch }}
  ask_skip_tags_on_launch: {{ item.ask_skip_tags_on_launch }}
  ask_job_type_on_launch: {{ item.ask_job_type_on_launch }}
  ask_verbosity_on_launch: {{ item.ask_verbosity_on_launch }}
  ask_inventory_on_launch: {{ item.ask_inventory_on_launch }}
  ask_credential_on_launch:  {{ item.ask_credential_on_launch }}
  ask_execution_environment_on_launch: {{ item.ask_execution_environment_on_launch }}
  ask_labels_on_launch: {{ item.ask_labels_on_launch }}
  ask_forks_on_launch: {{ item.ask_forks_on_launch }}
  ask_job_slice_count_on_launch: {{ item.ask_job_slice_count_on_launch }}
  ask_timeout_on_launch: {{ item.ask_timeout_on_launch }}
  ask_instance_groups_on_launch: {{ item.ask_instance_groups_on_launch }}
  survey_enabled: {{ item.survey_enabled }}
  survey_spec:
{{ (survey_api_response | first | to_nice_yaml(indent=2) | indent(4, first=true)).rstrip() }}
{% if credentials_api_response | length > 0 %}
  credentials:
{% for cred_name in (credentials_api_response | map(attribute='name') | list) %}
    - {{ cred_name }}
{% endfor %}
{% endif %}
  extra_vars: 
{{ (item.extra_vars | from_json | to_nice_yaml(indent=2) | indent(4, first=true)).rstrip() }}
{% set empty_bracket = '[]' %}
  notification_templates_started: {% if notification_templates_started_api_response | length == 0 %}{{ empty_bracket }}
{% else %}
{% for nts_name in (notification_templates_started_api_response | map(attribute='name') | list) %}

    - {{ nts_name }}
{% endfor %}
{% endif %}
  notification_templates_success: {% if notification_templates_success_api_response | length == 0 %}{{ empty_bracket }}
{% else %}
{% for nts_name in (notification_templates_success_api_response | map(attribute='name') | list) %}

    - {{ nts_name }}
{% endfor %}
{% endif %}
  notification_templates_error: {% if notification_templates_error_api_response | length == 0 %}{{ empty_bracket }} 
{% else %}
{% for nte_name in (notification_templates_error_api_response | map(attribute='name') | list) %}

    - {{ nte_name }}
{% endfor %}
{% endif %}
